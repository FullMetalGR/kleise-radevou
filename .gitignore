# Working specification and glossary. Kept on a developer's own disk rather than published.
# Every markdown file is local-only except the root README, which carries no specification.
# The negation must stay below the wildcard, and cannot rescue a file under an excluded
# directory, which is why docs/ stays excluded whatever it holds.
*.md
!/README.md
/docs/
/.scratch/

# Framework and tooling output.
*.log
.DS_Store
.env
.env.backup
.env.production
.phpactor.json
.phpunit.result.cache
/.fleet
/.idea
/.nova
/.phpunit.cache
/.vscode
/.zed
/auth.json
/node_modules/
/public/build/
# The booking bundle's sentences, written from lang/ by php artisan lang:export booking before
# every build; generated, so never committed.
/resources/js/booking/lines.generated.ts
# The admin's sections in English, written from lang/en/admin by php artisan lang:export admin
# before the type check and the component tests, the one module they build keyed tables from.
/resources/js/admin/lines.generated.ts
/public/fonts-manifest.dev.json
/public/hot
/public/storage
/storage/*.key
/storage/pail
/tests/Browser/Screenshots/
/vendor/
/.fallow-report.sarif
_ide_helper.php
Homestead.json
Homestead.yaml
Thumbs.db
