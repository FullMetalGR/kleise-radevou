APP_NAME="Kleise Radevou"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=kleise_radevou
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
# The platform's mails are sent in the public name, SITE_NAME below, unless MAIL_FROM_NAME is
# set to a sender name of its own (config/mail.php).

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# The platform billing provider, config/billing.php: Stripe, the platform's own account, with
# its secret key (sk_...), the webhook endpoint's signing secret (whsec_...) and two price ids
# (price_...). Unset, the application boots and serves; the first question that needs a missing
# key is refused with one sentence naming that key. Both plan prices must be set before any
# subscription is synced: while either is blank, every sync changes nothing and logs the plan
# and its key.
BILLING_SECRET_KEY=
BILLING_WEBHOOK_SECRET=
BILLING_FLOOR_PRICE=
BILLING_STAFF_PRICE=
# Automatic tax at the checkout, true to ask the provider to work out each invoice's tax. Only
# the word true (or (true)) turns it on: 1, on and yes are read as text and leave it off. Leave
# it false until the provider's tax settings hold the head office address and a registration:
# the provider refuses the checkout without the address. The tax id is collected either way.
BILLING_AUTOMATIC_TAX=false

# Platform mode for the tenants' payments, config/payments.php: the platform's own partner keys
# with Stripe (sk_... and the Connect endpoint's whsec_...) and the platform's fee, a percentage
# of at most two places ("1.5") and a fixed part per currency in that currency's minor units
# ("EUR:25,JPY:30"). While the keys or the fee are unset, platform mode is offered by nobody; a
# fee of 0 is a fee that takes nothing. These are not the billing keys above.
# The keys open, onboard and charge on the tenants' connected accounts; whsec_ signs their events.
PAYMENT_PLATFORM_STRIPE_SECRET_KEY=
PAYMENT_PLATFORM_STRIPE_WEBHOOK_SECRET=
PAYMENT_PLATFORM_FEE_PERCENT=
PAYMENT_PLATFORM_FEE_FIXED=

# Cloudflare Turnstile on the signup form, config/services.php: the widget's site key and its
# secret key. While either is unset the form renders no widget and the server checks nothing.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Google Maps for the business page's map, config/services.php: one key for the Geocoding and
# Static Maps APIs, used server-side alone. While it is unset the business page has no map.
GOOGLE_MAPS_KEY=

# Google Analytics on the central host, config/services.php: the GA4 measurement id,
# G-XXXXXXXXXX once the property exists, and the tag's script address, Google's gtag/js. While the
# id is empty there is no consent banner and nothing loads; the site asks before it does.
GA_MEASUREMENT_ID=
GA_SCRIPT=https://www.googletagmanager.com/gtag/js

# The platform console's clock, config/console.php: the zone every instant on the console and in
# an operator's sign-in notice is spelled in, named beside it. Unset, the console keeps
# Europe/Athens; an empty value is not unset, so remove the line rather than blank it.
CONSOLE_TIMEZONE=Europe/Athens

# The marketing site, config/site.php: the public name every page, the platform's mails' sender name
# and the legal texts read; the address the contact form mails and the admin's support sentences
# name; the legal entity the legal pages and the footer name, its name and address, and its VAT
# number, left empty while it has none, which leaves the number's clause out of the entity line; and
# whether the legal texts have been reviewed, false keeping the draft notice on each legal page,
# which also stays while a legal text still holds a gap to be confirmed. Each unset keeps the value
# shown; an empty value is not unset, so remove a line rather than blank it, ENTITY_VAT aside, whose
# empty value is its default.
SITE_NAME=kleiseradevou.gr
CONTACT_ADDRESS=support@kleiseradevou.gr
ENTITY_NAME="ADS Solutions O.E."
ENTITY_ADDRESS="Miltiadou 8, Nea Ionia, 142 31, Athens, Greece"
ENTITY_VAT=
LEGAL_REVIEWED=false
